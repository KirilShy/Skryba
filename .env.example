# Copy to .env and fill in what you want. Both are optional.

# Summaries and the Ask tab use a model on this machine when one is running
# (Ollama, LM Studio, llama.cpp, Jan) — nothing to configure. These are only
# needed to point somewhere else or pick a specific model.
# LOCAL_LLM_URL=http://192.168.1.20:11434
# LOCAL_LLM_MODEL=qwen2.5:3b
# LOCAL_LLM_CONTEXT=8192

# Without a local model, a paid API can write the summary instead.
# Use EITHER OpenRouter or the Anthropic API — OpenRouter wins if both are set.

# OpenRouter — one key, many models. https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Anthropic API directly. https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# Force a backend: local | anthropic | openrouter | auto
# SUMMARY_PROVIDER=auto

# Enables the "Speaker labels" toggle. Free token from
# https://huggingface.co/settings/tokens — you must also click "Agree" on
# https://huggingface.co/pyannote/speaker-diarization-3.1 and
# https://huggingface.co/pyannote/segmentation-3.0 while signed in.
# HF_TOKEN=hf_...

# Optional overrides
# WHISPER_MODEL=turbo      # turbo | large | medium | small
# CLAUDE_MODEL=claude-opus-5
# PORT=8420

# Seed the decoder with names and jargon it would otherwise guess at
# phonetically. Worth setting to the people and terms that recur in your
# meetings — it costs nothing and fixes mangled proper nouns.
# INITIAL_PROMPT=Spotkanie zespołu. Uczestnicy: Natalia, Paweł, Kirył. Tematy: legalizacja pobytu, Straż Graniczna, PIP, umowa zlecenie, koszty montażu.

# Whisper discards text invented over silences longer than this (seconds).
# HALLUCINATION_SILENCE_SECONDS=2.0
