# Copy to .env and fill in what you want. Both are optional.

# Enables the "AI summary" toggle (decisions + action items via Claude).
# ANTHROPIC_API_KEY=sk-ant-...

# Enables the "Speaker labels" toggle. Free token from
# https://huggingface.co/settings/tokens — you must also click "Agree" on
# https://huggingface.co/pyannote/speaker-diarization-3.1 and
# https://huggingface.co/pyannote/segmentation-3.0 while signed in.
# HF_TOKEN=hf_...

# Optional overrides
# WHISPER_MODEL=turbo      # turbo | large | medium | small
# CLAUDE_MODEL=claude-opus-5
# PORT=8420
